{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quote-desk-check/schema.json",
  "title": "Quote Desk Check data contracts",
  "description": "One schema file, one $def per stage. All data is synthetic; all prices are illustrative.",
  "$defs": {
    "field_id": {
      "enum": ["material_grade", "dimensions", "tolerance", "quantity", "finish", "certs", "delivery_date", "units"]
    },
    "family": {"enum": ["service_center", "machine_shop"]},

    "RFQ": {
      "type": "object",
      "required": ["id", "family", "received", "subject", "body", "attachments", "ambiguity"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^RFQ-[0-9]{3}$"},
        "family": {"$ref": "#/$defs/family"},
        "received": {"type": "string", "format": "date"},
        "subject": {"type": "string", "minLength": 3},
        "body": {"type": "string", "minLength": 40},
        "attachments": {"type": "array", "items": {"type": "string"}},
        "ambiguity": {"enum": ["none", "units_missing", "same_as_last_time", "attachment_filename"]},
        "paraphrased": {"type": "boolean"}
      }
    },

    "Label": {
      "type": "object",
      "required": ["id", "missing", "note"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^RFQ-[0-9]{3}$"},
        "missing": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/field_id"}},
        "note": {"type": "string"}
      }
    },

    "ExtractedField": {
      "type": "object",
      "required": ["value", "evidence"],
      "additionalProperties": false,
      "properties": {
        "value": {"type": ["string", "null"]},
        "evidence": {"type": ["string", "null"]}
      }
    },
    "Extraction": {
      "type": "object",
      "required": ["material_grade", "dimensions", "tolerance", "quantity", "finish", "certs", "delivery_date", "units"],
      "additionalProperties": false,
      "properties": {
        "material_grade": {"$ref": "#/$defs/ExtractedField"},
        "dimensions": {"$ref": "#/$defs/ExtractedField"},
        "tolerance": {"$ref": "#/$defs/ExtractedField"},
        "quantity": {"$ref": "#/$defs/ExtractedField"},
        "finish": {"$ref": "#/$defs/ExtractedField"},
        "certs": {"$ref": "#/$defs/ExtractedField"},
        "delivery_date": {"$ref": "#/$defs/ExtractedField"},
        "units": {"$ref": "#/$defs/ExtractedField"}
      }
    },

    "Flags": {
      "description": "Set by the deterministic checker only. The model never sets ready_to_price.",
      "type": "object",
      "required": ["present", "missing", "reasons", "ready_to_price"],
      "additionalProperties": false,
      "properties": {
        "present": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/field_id"}},
        "missing": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/field_id"}},
        "reasons": {
          "type": "object",
          "description": "field -> why it was marked missing (null value, failed format check, evidence not in email)",
          "additionalProperties": {"type": "string"}
        },
        "ready_to_price": {"type": "boolean"}
      }
    },

    "Draft": {
      "type": "object",
      "required": ["text", "covers_all_missing"],
      "additionalProperties": false,
      "properties": {
        "text": {"type": ["string", "null"]},
        "covers_all_missing": {"type": ["boolean", "null"]}
      }
    },

    "PriceStep": {
      "type": "object",
      "required": ["step", "detail", "value"],
      "additionalProperties": false,
      "properties": {
        "step": {"type": "string"},
        "detail": {"type": "string"},
        "value": {"type": "number"}
      }
    },
    "PriceTrace": {
      "type": "object",
      "required": ["status", "note", "steps", "unit_price", "total"],
      "additionalProperties": false,
      "properties": {
        "status": {"enum": ["priced", "withheld", "manual"]},
        "note": {"type": "string"},
        "steps": {"type": "array", "items": {"$ref": "#/$defs/PriceStep"}},
        "unit_price": {"type": ["number", "null"], "minimum": 0},
        "total": {"type": ["number", "null"], "minimum": 0}
      }
    },

    "SimilarJob": {
      "type": "object",
      "required": ["job_id", "score", "summary", "total_price", "lead_days"],
      "additionalProperties": false,
      "properties": {
        "job_id": {"type": "string", "pattern": "^JOB-[0-9]{3}$"},
        "score": {"type": "number", "minimum": -1, "maximum": 1},
        "summary": {"type": "string"},
        "total_price": {"type": "number", "exclusiveMinimum": 0},
        "lead_days": {"type": "integer", "minimum": 1}
      }
    },

    "Result": {
      "description": "One precomputed record per RFQ; this is what the static site renders.",
      "type": "object",
      "required": ["id", "family", "received", "subject", "body", "attachments", "ambiguity", "extraction", "flags", "draft", "price", "similar_jobs", "truth_missing"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "family": {"$ref": "#/$defs/family"},
        "received": {"type": "string", "format": "date"},
        "subject": {"type": "string"},
        "body": {"type": "string"},
        "attachments": {"type": "array", "items": {"type": "string"}},
        "ambiguity": {"type": "string"},
        "extraction": {"$ref": "#/$defs/Extraction"},
        "flags": {"$ref": "#/$defs/Flags"},
        "draft": {"$ref": "#/$defs/Draft"},
        "price": {"$ref": "#/$defs/PriceTrace"},
        "similar_jobs": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/SimilarJob"}},
        "truth_missing": {"type": "array", "items": {"$ref": "#/$defs/field_id"}}
      }
    }
  }
}
